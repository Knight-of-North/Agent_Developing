# 环境变量配置模板（M10：与 config.py 逐项对齐，共 28 项）
# 用法：复制本文件为 .env，按需修改。所有项都有代码内默认值，未配置也能跑。
# 注意：.env 已被 .gitignore 忽略，不会提交到 git；本文件是模板，可安全提交。

# ---------- DeepSeek API（必填 1 项）----------
DEEPSEEK_API_KEY=你的key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------- LLM 按用途调参（剧本创造性 / DM 稳重 / 玩家生动 / 投票冷静）----------
LLM_TEMP_SCRIPT=0.95        # 剧本生成温度
LLM_MAXTOK_SCRIPT=8192      # 剧本生成 max_tokens
LLM_TEMP_DM=0.7             # DM 台词温度
LLM_MAXTOK_DM=2048          # DM 台词 max_tokens
LLM_TEMP_PLAYER=0.85        # AI 玩家发言温度
LLM_MAXTOK_PLAYER=1024      # AI 玩家发言 max_tokens
LLM_TEMP_VOTE=0.3           # 投票温度（低 = 稳定）
LLM_MAXTOK_VOTE=512         # 投票 max_tokens

# ---------- LLM 行为 ----------
LLM_TIMEOUT=120             # 单次请求超时（秒）
LLM_MAX_RETRIES=3           # 失败重试次数（3×120s 最坏冻结约 6 分钟；瞬时抖动 2~3 次已足够）
LLM_REASONING_EFFORT=none   # deepseek-v4 推理力度：none/low/medium/high（影响延迟与成本）
TRUST_ENV=false             # 是否读系统代理环境变量（企业代理环境设 true）

# ---------- 游戏节奏 ----------
ROUNDS_PER_PLAYER=3         # 每人发言轮数（UI 可按局覆盖：快2/标准3/深入4）
INVESTIGATE_LIMIT=2         # 每局「调查现场」次数上限
MAX_CONSECUTIVE_FOLLOWUPS=1 # 玩家连续追问上限（防点名霸麦）

# ---------- 输入限制（防注入 + 防超长输入烧 token）----------
MAX_THEME_LEN=50
MAX_STORY_TIME_LEN=50
MAX_STORY_LOCATION_LEN=50
MAX_BG_STORY_LEN=2000
MAX_CHAT_LEN=500

# ---------- 性能 ----------
VOTE_CONCURRENT=true        # AI 投票/自我介绍是否线程池并发（异常时设 false 回退串行）
VOTE_MAX_WORKERS=5          # 并发线程数上限

# ---------- 调试 / 持久化 ----------
DEV_MODE=false              # true 时 Web 端显示 AI 内心戏与状态调试面板（剧透风险）
SCRIPT_MAX_ATTEMPTS=2       # 剧本自洽校验失败重试上限
PERSISTENT_CHECKPOINT=false # true 时用 SqliteSaver 持久化对局（需 pip install langgraph-checkpoint-sqlite）
